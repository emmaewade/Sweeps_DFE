// Recurrent Selection Script -- 202610 genic-only version
//
//  - 10 Mb chromosome (SEQLENGTH default)

initialize() {

	// ------------------------------------------------------------------------
	// SLIMGUI / LOCAL TEST DEFAULTS
	// Checks if variables exist (passed via -d on CLI). If not, sets defaults.
	// ------------------------------------------------------------------------
	if (!exists("run_name_output")) defineConstant("run_name_output", "Production_Run");
	if (!exists("BEN_S"))           defineConstant("BEN_S", 0.00032);        // Selection coefficient (s)
	if (!exists("BEN_FRAC"))        defineConstant("BEN_FRAC", 0.003125);    // fraction of nonsyn exonic muts beneficial (p*s = 1e-6)
	if (!exists("MU"))              defineConstant("MU", 1.5e-8);
	if (!exists("RECOM_RATE"))      defineConstant("RECOM_RATE", 1e-8);
	if (!exists("PATH"))            defineConstant("PATH", "/Users/emmaewade/Downloads/");
	if (!exists("SEQLENGTH"))       defineConstant("SEQLENGTH", 10000000);   // 10 Mb
	if (!exists("FIXED_GENS"))      defineConstant("FIXED_GENS", 2400);      // Post burn-in gens
	if (!exists("segment"))         defineConstant("segment", 1);
	if (!exists("N_POP"))           defineConstant("N_POP", 10000);          // Full population size
	// DFE for m2 (deleterious) -- human (Kim 2017): mean=-0.01314833, shape=0.186
	// or drosophila: mean=-0.00014, shape=0.36
	if (!exists("DFE_MEAN"))        defineConstant("DFE_MEAN", -0.01314833);
	if (!exists("DFE_SHAPE"))       defineConstant("DFE_SHAPE", 0.186);

	defineConstant("NAME_APPEND", run_name_output);

	print(PATH);
	print(NAME_APPEND);
	print(paste("BEN_S=", BEN_S, " BEN_FRAC=", BEN_FRAC, " DFE_MEAN=", DFE_MEAN, " DFE_SHAPE=", DFE_SHAPE, sep = ""));

	initializeMutationRate(MU);

	// ------------------------------------------------------------------------
	// MUTATION TYPES
	// ------------------------------------------------------------------------
	// m1: neutral (synonymous/intronic)
	initializeMutationType("m1", 0.5, "f", 0.0);

	// m2: deleterious (gamma DFE)
	initializeMutationType("m2", 0.5, "g", DFE_MEAN, DFE_SHAPE);

	// m3: beneficial (fixed effect BEN_S)
	initializeMutationType("m3", 0.5, "f", BEN_S);

	// ------------------------------------------------------------------------
	// GENOMIC ELEMENTS
	// ------------------------------------------------------------------------
	// NS:SYN = 69.8:30.2 as before; BEN_FRAC of the nonsyn share is beneficial,
	// so the total nonsyn target (m2 + m3) is unchanged.
	del_prop = 69.8 * (1.0 - BEN_FRAC);
	ben_prop = 69.8 * BEN_FRAC;

	initializeGenomicElementType("g1", c(m1, m2, m3), c(30.2, del_prop, ben_prop)); // Exon
	initializeGenomicElementType("g3", m1, 1.0);                                  // Intron

	// Generate random gene architecture along chromosome.
	// Intergenic gaps are physical distance only (no genomic element -> no mutations).
	base = 0;
	nc_length_total = 0;
	in_length_total = 0;
	ex_length_total = 0;
	ex_starts = integer(0); ex_ends = integer(0);
	in_starts = integer(0); in_ends = integer(0);

	while (base < SEQLENGTH) {
		nc_length = asInteger(runif(1, 500, 50000));
		nc_length_total = nc_length_total + nc_length;
		base = base + nc_length;

		ex_length = asInteger(rlnorm(1, log(50), log(2))) + 1;
		ex_length_total = ex_length_total + ex_length;
		initializeGenomicElement(g1, base, base + ex_length - 1);
		ex_starts = c(ex_starts, base); ex_ends = c(ex_ends, base + ex_length - 1);
		base = base + ex_length;

		do {
			in_length = asInteger(rlnorm(1, log(100), log(1.5))) + 10;
			in_length_total = in_length_total + in_length;
			initializeGenomicElement(g3, base, base + in_length - 1);
			in_starts = c(in_starts, base); in_ends = c(in_ends, base + in_length - 1);
			base = base + in_length;

			ex_length = asInteger(rlnorm(1, log(50), log(2))) + 1;
			ex_length_total = ex_length_total + ex_length;
			initializeGenomicElement(g1, base, base + ex_length - 1);
			ex_starts = c(ex_starts, base); ex_ends = c(ex_ends, base + ex_length - 1);
			base = base + ex_length;
		} while (runif(1) < 0.8);
	}

	defineConstant("EX_TOTAL", ex_length_total);
	defineConstant("IN_TOTAL", in_length_total);
	defineConstant("IG_TOTAL", nc_length_total);
	defineConstant("EX_STARTS", ex_starts); defineConstant("EX_ENDS", ex_ends);
	defineConstant("IN_STARTS", in_starts); defineConstant("IN_ENDS", in_ends);
	defineConstant("HET_WINDOW", 1000000); // 1 Mb window around center

	// SFS window: +/-5 Mb around the center = the whole 10 Mb chromosome only
	// (v4 single sweep also writes +/-1..4 Mb); one haplosome sample per sample size
	defineConstant("DISTANCES", c(5000000));
	defineConstant("SAMPLE_SIZES", c(10, 100, 1000));
	// sample size whose haplosomes are also written to VCF
	defineConstant("VCF_N", 100);

	initializeRecombinationRate(RECOM_RATE);
}

// ----------------------------------------------------------------------------
// SIMULATION INITIALIZATION & RESCHEDULING
// ----------------------------------------------------------------------------
1 early() {
	sim.addSubpop("p1", N_POP);

	defineConstant("BURNIN_GENS", 10 * N_POP); // 100,000 generations burn-in
	defineConstant("END_GEN", BURNIN_GENS + FIXED_GENS);

	community.rescheduleScriptBlock(s1, start=END_GEN, end=END_GEN);
}

// Logging tracker
1:1000000 late() {
	if (sim.cycle % 5000 == 0) {
		active_m3 = sim.mutations[sim.mutations.mutationType == m3];
		n_ben = size(active_m3);
		catn("Gen: " + sim.cycle + " | Active Beneficial Mutations (m3): " + n_ben);

		// Track every currently-segregating beneficial mutation: its position,
		// current frequency, and how many generations old it is. Written as a
		// long-format CSV (one row per active mutation per logged generation)

		if (n_ben > 0) {
			freqs = sim.mutationFrequencies(p1, active_m3);
			csv_path = paste(PATH, paste("active_sweeps_", NAME_APPEND, ".csv", sep = ""), sep = "/");

			if (!fileExists(csv_path))
			{
				header = "segment,generation,position,frequency,origin_generation,age_generations";
				writeFile(csv_path, header, append = F);
			}

			rows = string(0);
			for (i in seqAlong(active_m3)) {
				mut = active_m3[i];
				rows = c(rows, paste(segment, sim.cycle, mut.position, freqs[i], mut.originTick, sim.cycle - mut.originTick, sep = ","));
			}
			writeFile(csv_path, rows, append = T);
		}
	}
}

function (void)writeSummaryCSV(float hetRegion, integer nFixedBen)
{
	csv_path = paste(PATH, paste("summary_", NAME_APPEND, ".csv", sep = ""), sep = "/");

	if (!fileExists(csv_path))
	{
		header = "segment,ben_s,ben_frac,dfe_mean,dfe_shape,total_generations,fixed_beneficials,coding_bp,intron_bp,het_window_bp,mean_het_region,intergenic_bp";
		writeFile(csv_path, header, append = F);
	}

	row = paste(segment, BEN_S, BEN_FRAC, DFE_MEAN, DFE_SHAPE, sim.cycle, nFixedBen, EX_TOTAL, IN_TOTAL, HET_WINDOW, hetRegion, IG_TOTAL, sep = ",");
	writeFile(csv_path, row, append = T);
}

// One row per fixed beneficial (m3) substitution over the whole run, so sweep
// timing and position can be lined up with the windows / VCF.
function (void)writeFixedBeneficials(object<Substitution> fixedBen)
{
	out_path = paste(PATH, paste("fixed_beneficials_", NAME_APPEND, ".tsv", sep = ""), sep = "/");
	if (!fileExists(out_path))
		writeFile(out_path, "segment\tposition\ts\torigin_tick\tfixation_tick", append = F);
	if (size(fixedBen) == 0)
		return;
	rows = string(0);
	for (m in fixedBen)
		rows = c(rows, paste(segment, m.position, m.selectionCoeff, m.originTick, m.fixationTick, sep = "\t"));
	writeFile(out_path, rows, append = T);
}

// bp of the elements [starts, ends] that fall inside [win_start, win_end]
function (integer$)overlapBP(integer starts, integer ends, integer$ win_start, integer$ win_end)
{
	lo = pmax(starts, win_start);
	hi = pmin(ends, win_end);
	keep = hi >= lo;
	if (sum(keep) == 0) return 0;
	return asInteger(sum(hi[keep] - lo[keep] + 1));
}

// Exact exonic and intronic bp inside each DISTANCES window for this segment
// (genic_bp_<run>.csv, same layout as v4 single sweep).
function (void)writeWindowBP(void)
{
	csv_path = paste(PATH, paste("genic_bp_", NAME_APPEND, ".csv", sep = ""), sep = "/");
	if (!fileExists(csv_path))
		writeFile(csv_path, "segment,dist_mb,exon_bp,intron_bp", append = F);
	center = asInteger(SEQLENGTH / 2);
	for (dist in DISTANCES)
	{
		win_start = asInteger(max(0, center - dist));
		win_end = asInteger(min(SEQLENGTH - 1, center + dist));
		row = paste(segment, asInteger(dist / 1000000), overlapBP(EX_STARTS, EX_ENDS, win_start, win_end), overlapBP(IN_STARTS, IN_ENDS, win_start, win_end), sep = ",");
		writeFile(csv_path, row, append = T);
	}
}

// unfolded SFS (counts 1..n) of mutations `muts` carried by `haps`
function (integer)sfsOf(object<Haplosome> haps, object<Mutation> muts, integer$ n)
{
	counts = haps.mutationCountsInHaplosomes(mutations = muts);
	sfs = integer(n);
	for (i in seq(1, n))
		sfs[i - 1] = sum(counts == i);
	return sfs;
}

// Windowed SFS across SAMPLE_SIZES x DISTANCES. One sample per sample size,
// SFS computed within each (cumulative) window from that sample. Files:
//   syn_sfs_<run>_n<n>_d<d>mb.tsv         m1 (exonic syn + intronic)
//   nonsyn_sfs_<run>_n<n>_d<d>mb.tsv      m2 + m3 
//   nonsyn_del_sfs_<run>_n<n>_d<d>mb.tsv  m2 only
//   nonsyn_ben_sfs_<run>_n<n>_d<d>mb.tsv  m3 only
// The n = VCF_N sample is also written as a whole-chromosome VCF:
//   vcf_<run>_seg<segment>.vcf   (gzipped by the submit script)
function (void)writeWindowedSFS(void)
{
	center = asInteger(SEQLENGTH / 2);

	for (sample_size in SAMPLE_SIZES)
	{
		sampledHaploidGenomes = sample(p1.haplosomes, sample_size);

		if (sample_size == VCF_N)
		{
			vcf_path = paste(PATH, paste("vcf_", NAME_APPEND, "_seg", segment, ".vcf", sep = ""), sep = "/");
			sampledHaploidGenomes.outputHaplosomesToVCF(vcf_path);
		}

		m1All = unique(sampledHaploidGenomes.mutationsOfType(m1));
		m2All = unique(sampledHaploidGenomes.mutationsOfType(m2));
		m3All = unique(sampledHaploidGenomes.mutationsOfType(m3));

		for (dist in DISTANCES)
		{
			win_start = max(0, center - dist);
			win_end = min(SEQLENGTH - 1, center + dist);

			m1_sfs = sfsOf(sampledHaploidGenomes, m1All[m1All.position >= win_start & m1All.position <= win_end], sample_size);
			m2_sfs = sfsOf(sampledHaploidGenomes, m2All[m2All.position >= win_start & m2All.position <= win_end], sample_size);
			m3_sfs = sfsOf(sampledHaploidGenomes, m3All[m3All.position >= win_start & m3All.position <= win_end], sample_size);

			tag = paste(NAME_APPEND, "_n", sample_size, "_d", asInteger(dist / 1000000), "mb.tsv", sep = "");
			writeFile(paste(PATH, "syn_sfs_" + tag, sep = "/"), paste(asString(m1_sfs), sep = "\t"), append = T);
			writeFile(paste(PATH, "nonsyn_sfs_" + tag, sep = "/"), paste(asString(m2_sfs + m3_sfs), sep = "\t"), append = T);
			writeFile(paste(PATH, "nonsyn_del_sfs_" + tag, sep = "/"), paste(asString(m2_sfs), sep = "\t"), append = T);
			writeFile(paste(PATH, "nonsyn_ben_sfs_" + tag, sep = "/"), paste(asString(m3_sfs), sep = "\t"), append = T);
		}
	}

	print("printed windowed SFS");
}

// ----------------------------------------------------------------------------
// FINAL EVALUATION BLOCK
// ----------------------------------------------------------------------------
s1 late() {
	catn("=== Finished at generation: " + sim.cycle + " ===");

	fixed_muts = sim.substitutions;
	fixed_m3 = fixed_muts[fixed_muts.mutationType == m3];
	catn("Total beneficial mutations fixed: " + size(fixed_m3));

	writeFile(paste(PATH, paste("fixed_positions_", NAME_APPEND, ".txt", sep = ""), sep = "/"), paste(fixed_muts.position, sep=", "), append=T);
	writeFixedBeneficials(fixed_m3);

	writeWindowedSFS();
	writeWindowBP();

	win_start = max(0, asInteger(SEQLENGTH / 2) - HET_WINDOW);
	win_end = min(SEQLENGTH - 1, asInteger(SEQLENGTH / 2) + HET_WINDOW);
	het_region = calcHeterozygosity(p1.haplosomes, start = win_start, end = win_end);

	writeSummaryCSV(het_region, size(fixed_m3));

	sim.simulationFinished();
}
